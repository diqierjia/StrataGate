{
  "name": "stratagate-dsh",
  "version": "0.2.1",
  "description": "Automatic local-first cross-session memory for DeepSeek Harness with source-traceable recall",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/build-client.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent-memory",
    "cross-session-memory",
    "persistent-memory",
    "project-memory",
    "conversation-memory",
    "long-term-memory",
    "local-first",
    "source-tracing",
    "evidence-gate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diqierjia/StrataGate-AgentMemory.git",
    "directory": "integrations/deepseek-harness"
  },
  "license": "MIT",
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "package.json"
    },
    "compatibility": {
      "dshVersions": ["0.1.0-rc.6", "0.1.0-rc.7"],
      "nodeVersions": ["22.19.x", "24.x"]
    },
    "permissions": [
      "harness:tool",
      "filesystem:read",
      "filesystem:write",
      "network:none",
      "subprocess:none",
      "shell:none",
      "python:none",
      "credentials:none"
    ]
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "tsup": "^8.5.0"
  }
}
